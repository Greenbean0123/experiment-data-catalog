    "categories": {
      "示例系列": "Example series",
      "时间系列": "Time course",
      "资料分类": "Reference materials"
    },
    "datasetTitles": {
      "示例图谱": "Example plots"
    },
    "noteLines": {
      "示例说明：": "Example note:",
