    },
    "noteRules": [
      {
        "pattern": "^批量导入：(.+)。$",
        "flags": "",
        "replacement": "Bulk import: $1."
      },
      {
        "pattern": "^导入来源：(.+)。$",
        "flags": "",
        "replacement": "Import source: $1."
      },
      {
        "pattern": "^Name / 名称: ",
        "flags": "",
        "replacement": "Name: "
      },
      {
        "pattern": "^([\\d.]+) min 为示例时刻，据 (.+)。$",
        "flags": "",
        "replacement": "$1 min is an example time from $2."
      },
      {
        "pattern": "([",
        "flags": "",
        "replacement": "invalid patterns are ignored"
      }
    ]
  }
}
